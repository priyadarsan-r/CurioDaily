# CurioDaily Environment Variables Template
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Official Meta Instagram Graph API Credentials
# (Required for production publishing to Instagram)
# -----------------------------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Optional Meta Developer App Credentials (for automated token refreshes)
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=

# -----------------------------------------------------------------------------
# Public Media Hosting Base URL
# Where Meta will retrieve your generated MP4 video and image assets.
# Example: https://<username>.github.io/<repo-name>/media
# -----------------------------------------------------------------------------
PUBLIC_MEDIA_BASE_URL=https://raw.githubusercontent.com/curiodaily/curiodaily-engine/gh-pages/media

# -----------------------------------------------------------------------------
# Optional AI Video & Stock Video API Keys
# (If left empty, system automatically uses free Wikimedia/NASA + Ken Burns fallback)
# -----------------------------------------------------------------------------
PEXELS_API_KEY=
PIXABAY_API_KEY=
REPLICATE_API_TOKEN=

# -----------------------------------------------------------------------------
# Emergency Publishing Kill Switch
# Set to 'true' to immediately pause all publishing workflows
# -----------------------------------------------------------------------------
PUBLISHING_PAUSED=false
